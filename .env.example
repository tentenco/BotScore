# Public app origin used to create report links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL is shared by the web process and the durable audit worker.
DATABASE_URL=postgresql://inspector:inspector@localhost:5432/inspector
DATABASE_POOL_MAX=10
QUEUE_DATABASE_POOL_MAX=5

# Optional OpenRouter narration. Without these, deterministic copy is used.
ENABLE_OPENROUTER_NARRATIVE=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional HubSpot contact upsert.
HUBSPOT_PRIVATE_APP_TOKEN=

# Optional listmonk transactional delivery.
LISTMONK_URL=
LISTMONK_USERNAME=
LISTMONK_PASSWORD=
LISTMONK_REPORT_TEMPLATE_ID=

# Optional Chrome override. Common macOS paths are auto-detected locally.
CHROME_EXECUTABLE_PATH=

# Limits.
AUDIT_MAX_RESPONSE_BYTES=2097152
AUDIT_FETCH_TIMEOUT_MS=15000
AUDIT_RENDER_TIMEOUT_MS=20000
AUDIT_CONCURRENCY=2
AUDIT_CACHE_TTL_SECONDS=21600
AUDIT_RETRY_LIMIT=2
AUDIT_RETRY_DELAY_SECONDS=15
AUDIT_JOB_TIMEOUT_SECONDS=300
AUDIT_RETENTION_DAYS=90
TRUST_PROXY_HEADERS=false
TRUST_CLOUDFLARE_HEADERS=false
RATE_LIMIT_SALT=replace-with-a-long-random-value-in-production
