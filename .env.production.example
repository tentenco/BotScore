# Copy to .env on the Ubuntu VPS. Use only URL-safe characters in POSTGRES_PASSWORD.
APP_DOMAIN=geo.example.com
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password
RATE_LIMIT_SALT=replace-with-a-different-long-random-value

# Two concurrent browsers is a safe starting point for a 4 GB VPS.
AUDIT_CONCURRENCY=2
AUDIT_CACHE_TTL_SECONDS=21600
AUDIT_RETRY_LIMIT=2
AUDIT_JOB_TIMEOUT_SECONDS=300
AUDIT_RETENTION_DAYS=90

ENABLE_OPENROUTER_NARRATIVE=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

HUBSPOT_PRIVATE_APP_TOKEN=
LISTMONK_URL=
LISTMONK_USERNAME=
LISTMONK_PASSWORD=
LISTMONK_REPORT_TEMPLATE_ID=
